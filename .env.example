# URL base de EVA (podés apuntar a otra instancia Moodle compatible)
EVA_BASE_URL=https://eva.fing.edu.uy

# Opcional: token de Web Services de Moodle. Si no lo configurás, ejecutá `npm run login`.
# EVA_TOKEN=

# Servicio asociado al token (el de la app móvil funciona para lectura).
EVA_WS_SERVICE=moodle_mobile_app

# Directorio de datos (sesión y descargas). Por defecto: ~/.mcp-eva
# EVA_DATA_DIR=

# Sesión guardada por `npm run login`.
# EVA_SESSION_FILE=

# Descargas
# EVA_DOWNLOADS_DIR=
# EVA_MAX_DOWNLOAD_BYTES=209715200

# Navegador para el login (msedge o chrome).
EVA_BROWSER_CHANNEL=msedge
# EVA_BROWSER_HEADLESS=false

# Credenciales opcionales para login automático. Si las omitís, se abre una ventana
# para que inicies sesión a mano (recomendado).
# EVA_USERNAME=
# EVA_PASSWORD=

# Servidor REST
EVA_API_HOST=127.0.0.1
EVA_API_PORT=8787
# EVA_API_KEY=

# Comportamiento
EVA_REQUEST_TIMEOUT_MS=30000
EVA_LOGIN_TIMEOUT_MS=300000
EVA_CACHE_TTL_MS=120000
EVA_LOG_LEVEL=info
EVA_READ_ONLY=true
