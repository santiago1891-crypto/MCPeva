{
  "name": "mcp-eva",
  "version": "0.1.0",
  "private": true,
  "description": "Backend y servidor MCP para recorrer y trabajar con la plataforma EVA FING (Moodle).",
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "bin": {
    "mcp-eva": "./dist/cli/index.js",
    "eva": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli/index.js",
    "api": "tsx src/cli/index.ts api",
    "mcp": "tsx src/cli/index.ts mcp",
    "login": "tsx src/cli/index.ts login",
    "token": "tsx src/cli/index.ts token",
    "logout": "tsx src/cli/index.ts logout",
    "status": "tsx src/cli/index.ts status",
    "courses": "tsx src/cli/index.ts courses",
    "contents": "tsx src/cli/index.ts contents",
    "search": "tsx src/cli/index.ts search",
    "content": "tsx src/cli/index.ts content",
    "files": "tsx src/cli/index.ts files",
    "download": "tsx src/cli/index.ts download",
    "tui": "tsx src/cli/index.ts tui",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.7",
    "ink": "^6.8.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "tough-cookie": "^5.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
